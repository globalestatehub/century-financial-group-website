# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://centuryfinancialgroup.net

# MySQL connection string for partnership inquiries and mortgage leads
# (the same database the previous site wrote to; schema in drizzle/).
DATABASE_URL=mysql://user:password@host:3306/database

# Basic Auth credentials for /dashboard/mortgage-leads. If either is empty,
# the dashboard stays locked.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
