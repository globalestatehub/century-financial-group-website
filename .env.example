# Copy to .env.local for local development and set the same keys in Vercel.
# Never commit real values (.env* files are git-ignored).

# Public site URL, used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://centuryfinancialgroup.net

# --- Forms -> n8n (server-side only; n8n sends all notification emails) ---
SITE_FORMS_KEY=
SITE_NAME=Century Financial Group Net
SITE_CONTACT_EMAIL=info@centuryfinancialgroup.net

# --- Cloudflare Turnstile ---
# Public site key (safe to expose).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFHWb2rHJ_yYHvH9
# Secret key: server-side only. Forms are rejected until this is set.
TURNSTILE_SECRET_KEY=
# Hostnames allowed to submit forms (comma-separated). Defaults to the
# NEXT_PUBLIC_SITE_URL host + www. Never include localhost in production;
# for local testing use TURNSTILE_HOSTNAMES=localhost in .env.local.
TURNSTILE_HOSTNAMES=

# --- Optional lead database (feeds /dashboard/mortgage-leads) ---
# MySQL connection string; schema in drizzle/. Leave empty to rely on n8n only.
DATABASE_URL=

# Basic Auth for /dashboard/mortgage-leads. Dashboard stays locked if unset.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
